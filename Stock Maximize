public static long stockmax(List<Integer> prices) {
        long profit=0;
        long max=0;
        for(int i=prices.size()-1;i>=0;i--){
            
            if(prices.get(i)>max){
                max=prices.get(i);
            }
            else{
                profit+=max-prices.get(i);
            }
        }
        return profit;

    }
